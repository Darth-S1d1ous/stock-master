# Copy to .env. Never commit real keys.

# openai | nvidia
AGENT_LLM_PROVIDER=nvidia

# Shared fallback. Provider-specific keys win when set.
# AGENT_LLM_API_KEY=

# AGENT_LLM_OPENAI_API_KEY=
# OPENAI_API_KEY=

AGENT_LLM_NVIDIA_API_KEY=
# NVIDIA_API_KEY=

# Optional. Defaults are bound to the selected provider host.
# AGENT_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# AGENT_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_TOKENS=4096
AGENT_LLM_PROMPT_VERSION=condition-author-v1
