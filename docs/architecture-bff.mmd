flowchart LR
    U[User's Browser]

    subgraph WEB["Web Frontend / BFF"]
        MW[access middlewares<br/>session authentication / CSRF / security headers / Request ID]
        UI[Next.js page<br/>Server Components + some Client Components]
        BFF[BFF Route Handlers<br/>parameter validation / API aggregation / Error Transformation]
        CLIENT[FastAPI Client<br/>Bearer Injection / Time Out / Trace ID]
    end

    subgraph BACKEND["Current FastAPI Backend (Fixed temporarily)"]
        API["/api/v1"]
        AUTH[Bearer Token Authentication]
        THESIS[Thesis API]
        EVENT[Event API]
        MONITOR[Deterministic Monitoring Service]
        REPO[SQLAlchemy Repository]
    end

    DB[(PostgreSQL)]
    PROVIDERS[Alpha Vantage<br/>Finnhub<br/>Yahoo Finance]
    INGEST[CLI / Cron Sampling]

    U -->|HTTPS| MW
    MW --> UI
    UI --> BFF
    BFF --> CLIENT
    CLIENT -->|Server-side Bearer Token| API

    API --> AUTH
    AUTH --> THESIS
    AUTH --> EVENT
    THESIS --> MONITOR
    THESIS --> REPO
    EVENT --> REPO
    MONITOR --> REPO
    REPO --> DB

    PROVIDERS --> INGEST
    INGEST --> DB
